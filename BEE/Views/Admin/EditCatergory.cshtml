@model BEE.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa thể loại - Steam Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px; margin-bottom: 50px; color: #c7d5e0;">
    <div style="background-color: #1b2838; border: 1px solid #2a475e; padding: 30px; border-radius: 8px;">
        <h2 style="color: #66c0f4; font-weight: bold; margin-bottom: 20px;">✏️ Chỉnh sửa Thể Loại Game</h2>
        <hr style="border-color: #2a475e;" />

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CategoryID)

            <div class="form-group" style="margin-bottom: 25px;">
                <label style="color: #66c0f4; font-weight: bold; margin-bottom: 8px; display: block;">Tên Thể Loại:</label>
                @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control", @required = "required", style = "background-color: #101822; color: #fff; border: 1px solid #2a475e; padding: 10px;" })
            </div>

            <div style="display: flex; gap: 15px;">
                <button type="submit" class="btn btn-success btn-lg" style="background-color: #5c7e10; border: none; font-weight: bold; padding: 10px 25px;">Cập nhật</button>
                <a href="@Url.Action("Categories", "Admin")" class="btn btn-outline-secondary" style="color: #c7d5e0; border-color: #2a475e; padding: 10px 20px;">Quay lại</a>
            </div>
        }
    </div>
</div>