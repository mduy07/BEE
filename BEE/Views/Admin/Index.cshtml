@model IEnumerable<BEE.Models.Product>
@{
    ViewBag.Title = "Quản lý kho game - Steam Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="color: #66c0f4; font-weight: bold;">🛠 Quản trị danh sách Tựa Game</h2>
        <a href="@Url.Action("Create", "Admin")" class="btn btn-success" style="background-color: #5c7e10; border: none; font-weight: bold;">
            ➕ Thêm Game Mới
        </a>
    </div>
    <hr style="border-color: #2a475e;" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: #1b2838; border-color: #5c7e10; color: #beee11;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-dark table-striped" style="background-color: #1b2838; border-radius: 6px; overflow: hidden;">
            <thead>
                <tr style="background-color: #2a475e; color: #66c0f4;">
                    <th>Hình ảnh</th>
                    <th>Tên Game</th>
                    <th>Thể loại</th>
                    <th>Giá bán</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center" style="padding: 30px; color: #c7d5e0;">
                            Chưa có tựa game nào trong kho. Hãy bấm nút <b>"➕ Thêm Game Mới"</b> phía trên để bắt đầu thêm nhé!
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td style="width: 100px; vertical-align: middle;">
                                @{
                                    string imgPath = "";
                                    if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        imgPath = item.ProductImage.StartsWith("http") ? item.ProductImage : Url.Content("~/Content/images/" + item.ProductImage);
                                    }
                                    else
                                    {
                                        imgPath = "https://via.placeholder.com/80x50?text=No+Image";
                                    }
                                }
                                <img src="@imgPath" style="width: 80px; height: 50px; object-fit: cover; border-radius: 4px;" alt="@item.ProductName" />
                            </td>
                            <td style="vertical-align: middle; font-weight: bold; color: #fff;">@item.ProductName</td>
                            <td style="vertical-align: middle; color: #c7d5e0;">@(item.Category != null ? item.Category.CategoryName : "Chưa phân loại")</td>
                            <td style="vertical-align: middle; color: #beee11; font-weight: bold;">@item.ProductPrice.ToString("N0") VNĐ</td>
                            <td style="vertical-align: middle; text-align: center;">
                                <a href="@Url.Action("Edit", "Admin", new { id = item.ProductID })" class="btn btn-sm btn-primary" style="margin-right: 5px;">Sửa</a>
                                <a href="@Url.Action("Delete", "Admin", new { id = item.ProductID })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa tựa game này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>