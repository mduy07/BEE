@model IEnumerable<BEE.Models.Order>

    @{
        ViewBag.Title = "Quản lý đơn hàng - Steam Admin";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    <div class="container" style="margin-top: 30px; margin-bottom: 50px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="color: #66c0f4; font-weight: bold;">📦 Quản lý Đơn hàng toàn hệ thống</h2>
            <div style="display: flex; gap: 10px;">
                <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary" style="color: #c7d5e0; border-color: #2a475e;">&larr; Quản lý Game</a>
                <a href="@Url.Action("Categories", "Admin")" class="btn btn-outline-secondary" style="color: #c7d5e0; border-color: #2a475e;">Quản lý Thể loại</a>
            </div>
        </div>
        <hr style="border-color: #2a475e;" />

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center" style="background-color: #1b2838; border-color: #2a475e; color: #c7d5e0; padding: 30px;">
                <h4>Hệ thống chưa có đơn hàng nào!</h4>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-striped" style="background-color: #1b2838; border-radius: 6px; overflow: hidden;">
                    <thead>
                        <tr style="background-color: #2a475e; color: #66c0f4;">
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="vertical-align: middle; font-weight: bold; color: #fff;">#@item.OrderID</td>
                                <td style="vertical-align: middle; color: #c7d5e0;">
                                    @(item.Customer != null ? item.Customer.Username : "Khách vãng lai")
                                </td>
                                <td style="vertical-align: middle; color: #8f98a0;">
                                    @(item.OrderDate != null ? item.OrderDate.ToString("dd/MM/yyyy HH:mm") : "")
                                </td>
                                <td style="vertical-align: middle; color: #beee11; font-weight: bold;">@item.TotalAmount.ToString("N0") VNĐ</td>
                                <td style="vertical-align: middle;">
                                    <span class="badge" style="background-color: #5c7e10; padding: 5px 10px;">
                                        @(string.IsNullOrEmpty(item.PaymentStatus) ? "Thành công" : item.PaymentStatus)
                                    </span>
                                </td>
                                <td style="vertical-align: middle; text-align: center;">
                                    <a href="@Url.Action("OrderDetails", "Admin", new { id = item.OrderID })" class="btn btn-sm btn-info" style="font-weight: bold;">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
