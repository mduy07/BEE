@model BEE.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID + " - Steam Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="color: #66c0f4; font-weight: bold;">📄 Chi tiết đơn hàng #@Model.OrderID</h2>
        <a href="@Url.Action("Orders", "Admin")" class="btn btn-outline-secondary" style="color: #c7d5e0; border-color: #2a475e;">
            &larr; Quay lại danh sách đơn hàng
        </a>
    </div>
    <hr style="border-color: #2a475e;" />

    <div style="background-color: #1b2838; border: 1px solid #2a475e; padding: 20px; border-radius: 6px; margin-bottom: 25px; color: #c7d5e0;">
        <div class="row">
            <div class="col-md-3">
                <p><b>👤 Khách hàng:</b> <span style="color: #fff;">@(Model.Customer != null ? Model.Customer.Username : "N/A")</span></p>
            </div>
            <div class="col-md-3">
                <p><b>📅 Ngày đặt:</b> @(Model.OrderDate != null ? Model.OrderDate.ToString("dd/MM/yyyy HH:mm") : "")</p>
            </div>
            <div class="col-md-3">
                <p><b>📍 Địa chỉ:</b> @(string.IsNullOrEmpty(Model.AddressDelivery) ? "Không có" : Model.AddressDelivery)</p>
            </div>
            <div class="col-md-3">
                <p><b>💳 Trạng thái:</b> <span class="badge" style="background-color: #5c7e10; padding: 5px 10px;">@(string.IsNullOrEmpty(Model.PaymentStatus) ? "Thành công" : Model.PaymentStatus)</span></p>
            </div>
        </div>
    </div>

    <h4 style="color: #66c0f4; font-weight: bold; margin-bottom: 15px;">Danh sách sản phẩm trong đơn:</h4>

    <div class="table-responsive">
        <table class="table table-dark table-striped" style="background-color: #1b2838; border-radius: 6px; overflow: hidden;">
            <thead>
                <tr style="background-color: #2a475e; color: #66c0f4;">
                    <th>Hình ảnh</th>
                    <th>Tên Game</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderDetails != null)
                {
                    foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td style="width: 100px; vertical-align: middle;">
                                @{
                                    string imgPath = "";
                                    if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ProductImage))
                                    {
                                        imgPath = detail.Product.ProductImage.StartsWith("http") ? detail.Product.ProductImage : Url.Content("~/Content/images/" + detail.Product.ProductImage);
                                    }
                                }
                                @if (!string.IsNullOrEmpty(imgPath))
                                {
                                    <img src="@imgPath" style="width: 80px; height: 50px; object-fit: cover; border-radius: 4px;" alt="" />
                                }
                                else
                                {
                                    <img src="https://via.placeholder.com/80x50?text=Game" style="width: 80px; height: 50px; object-fit: cover; border-radius: 4px;" alt="" />
                                }
                            </td>
                            <td style="vertical-align: middle; font-weight: bold; color: #fff;">
                                @(detail.Product != null ? detail.Product.ProductName : "Sản phẩm #" + detail.ProductID)
                            </td>
                            <td style="vertical-align: middle; color: #beee11;">@detail.UnitPrice.ToString("N0") VNĐ</td>
                            <td style="vertical-align: middle;">@detail.Quantity</td>
                            <td style="vertical-align: middle; color: #beee11; font-weight: bold;">@((detail.UnitPrice * detail.Quantity).ToString("N0")) VNĐ</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="text-right" style="text-align: right; margin-top: 20px; background-color: #0e141d; padding: 20px; border-radius: 6px;">
        <h3 style="color: #fff; margin: 0;">
            Tổng doanh thu đơn hàng: <span style="color: #beee11; font-weight: bold;">@Model.TotalAmount.ToString("N0") VNĐ</span>
        </h3>
    </div>
</div>