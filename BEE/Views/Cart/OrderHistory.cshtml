@model IEnumerable<BEE.Models.Order>
    @{
        ViewBag.Title = "Lịch sử mua game - Steam Store";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <div class="container" style="margin-top: 30px;">
        <h2 style="color: #66c0f4; font-weight: bold;">📜 Lịch sử giao dịch bản quyền</h2>
        <hr style="border-color: #2a475e;" />

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center" style="background-color: #1b2838; border-color: #2a475e; color: #c7d5e0; padding: 30px;">
                <h4>Bạn chưa có giao dịch mua game nào!</h4>
                <p>Hãy lựa chọn những tựa game đỉnh cao ngay hôm nay.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-steam" style="margin-top: 10px;">Khám phá Cửa hàng</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-striped" style="background-color: #1b2838; border-radius: 6px; overflow: hidden;">
                    <thead>
                        <tr style="background-color: #2a475e; color: #66c0f4;">
                            <th>Mã đơn hàng</th>
                            <th>Ngày mua</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td style="vertical-align: middle; font-weight: bold; color: #fff;">#@order.OrderID</td>
                                <td style="vertical-align: middle; color: #c7d5e0;">@(order.OrderDate != null ? order.OrderDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
                                <td style="vertical-align: middle; color: #beee11; font-weight: bold;">@order.TotalAmount.ToString("N0") VNĐ</td>
                                <td style="vertical-align: middle;">
                                    <span class="badge bg-success" style="background-color: #5c7e10 !important; padding: 6px 12px;">Thành công</span>
                                </td>
                                <td style="vertical-align: middle;">
                                    <a href="@Url.Action("OrderDetail", "Cart", new { id = order.OrderID })" class="btn btn-sm btn-outline-info" style="color: #66c0f4; border-color: #2a475e;">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
