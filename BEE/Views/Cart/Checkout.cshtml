
@{
    ViewBag.Title = "Thanh toán - Steam Game Store";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal total = ViewBag.Total != null
        ? Convert.ToDecimal(ViewBag.Total)
        : 0;
}

<style>
    .checkout-container {
        margin-top: 40px;
        margin-bottom: 60px;
        color: #c7d5e0;
    }

    .checkout-box {
        background: #1b2838;
        border: 1px solid #2a475e;
        border-radius: 10px;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    }

    .checkout-title {
        color: #66c0f4;
        font-weight: bold;
    }

    .checkout-label {
        display: block;
        color: #66c0f4;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .checkout-input {
        background: #101822;
        color: white;
        border: 1px solid #2a475e;
        padding: 12px;
        width: 100%;
        border-radius: 5px;
    }

        .checkout-input:focus {
            outline: none;
            border-color: #66c0f4;
        }

    .total-box {
        background: #101822;
        border: 1px solid #2a475e;
        padding: 22px;
        border-radius: 7px;
        margin-top: 25px;
    }

    .total-price {
        color: #beee11;
        font-size: 25px;
        font-weight: bold;
    }

    .btn-confirm {
        background: #5c7e10;
        color: white;
        font-weight: bold;
        border: none;
        padding: 12px 25px;
    }

        .btn-confirm:hover {
            background: #7da313;
            color: white;
        }
</style>

<div class="container checkout-container">

    <div class="checkout-box">

        <h2 class="checkout-title">
            💳 Xác nhận thanh toán
        </h2>

        <p style="color:#8f98a0;">
            Vui lòng kiểm tra thông tin trước khi đặt hàng.
        </p>

        <hr style="border-color:#2a475e;" />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm(
            "Checkout",
            "Cart",
            FormMethod.Post,
            new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">

                <label class="checkout-label">
                    📍 Địa chỉ nhận hàng / Thông tin liên lạc
                </label>

                <textarea name="shippingAddress"
                          class="checkout-input"
                          rows="4"
                          required
                          maxlength="500"
                          placeholder="Nhập địa chỉ hoặc thông tin liên lạc..."></textarea>

            </div>

            <div class="total-box">

                <p style="color:#c7d5e0;">
                    Phương thức thanh toán:
                </p>

                <h5 style="color:white;">
                    Thanh toán khi xác nhận đơn hàng
                </h5>

                <hr style="border-color:#2a475e;" />

                <div class="d-flex justify-content-between align-items-center flex-wrap">

                    <div>
                        <h5 style="color:white;">
                            Tổng tiền cần thanh toán
                        </h5>

                        <div class="total-price">
                            @total.ToString("N0") VNĐ
                        </div>
                    </div>

                    <div class="mt-3">

                        <button type="submit"
                                class="btn btn-confirm btn-lg">
                            ✓ Xác nhận đặt hàng
                        </button>

                    </div>

                </div>

            </div>
        }

        <div class="mt-4">

            <a href="@Url.Action("Index", "Cart")"
               class="btn btn-outline-info">
                ← Quay lại giỏ hàng
            </a>

        </div>

    </div>

</div>
