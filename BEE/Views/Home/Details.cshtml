@model BEE.Models.Product

@{
    ViewBag.Title = Model.ProductName + " - Steam Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <div class="row">
        <!-- Banner Game -->
        <div class="col-md-7">
            @if (!string.IsNullOrEmpty(Model.ProductImage))
            {
                string imgPath = Model.ProductImage.StartsWith("http") ? Model.ProductImage : Url.Content("~/Content/images/" + Model.ProductImage);
                <img src="@imgPath" alt="@Model.ProductName" style="width: 100%; border-radius: 6px; border: 1px solid #2a475e; box-shadow: 0 6px 18px rgba(0,0,0,0.5);" />
            }
            else
            {
                <img src="https://via.placeholder.com/600x350?text=Steam+Game+Poster" style="width: 100%; border-radius: 6px;" alt="No image" />
            }
        </div>

        <!-- Thông tin Game & Nút mua -->
        <div class="col-md-5">
            <h2 style="color: #66c0f4; font-weight: bold; margin-bottom: 10px;">@Model.ProductName</h2>
            <hr style="border-color: #2a475e;" />

            <div style="background-color: #0e141d; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
                <span style="color: #8f98a0; font-size: 14px;">Giá bán bản quyền:</span>
                <h3 style="color: #beee11; font-weight: bold; margin-top: 5px;">@Model.ProductPrice.ToString("N0") VNĐ</h3>
            </div>

            <p style="color: #acb2b8; line-height: 1.6; min-height: 80px;">
                Tựa game bản quyền chính hãng, kích hoạt trực tiếp và tận hưởng trải nghiệm đỉnh cao trên hệ thống phân phối game trực tuyến Steam.
            </p>

            <div style="margin-top: 30px;">
                <a href="@Url.Action("AddToCart", "Cart", new { id = Model.ProductID })" class="btn btn-success btn-lg" style="width: 100%; background-color: #5c7e10; border: none; font-weight: bold; padding: 12px;">
                    🛒 Thêm vào giỏ hàng
                </a>
            </div>

            <div style="margin-top: 12px;">
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary" style="width: 100%; color: #c7d5e0; border-color: #2a475e;">
                    &larr; Quay lại danh sách Game
                </a>
            </div>
        </div>
    </div>
</div>